{
  "name": "cirkali",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Planificateur et lecteur de seance au poids du corps, multilingue, sans compte obligatoire",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/build-exercise-pages.ts",
    "preview": "vite preview",
