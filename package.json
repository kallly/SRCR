    "exo": "tsx scripts/show-exercise.ts",
    "check": "npm run build && tsx scripts/check-build.ts",
    "indexnow": "tsx scripts/indexnow.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "qrcode-generator": "^2.0.4"
  }
