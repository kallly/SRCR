{
  "name": "cirkali",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Planificateur et lecteur de seance au poids du corps, multilingue, sans compte obligatoire",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/build-exercise-pages.ts",
    "build:app": "tsx scripts/build-app.ts",
    "app:sync": "npm run build:app && cap sync",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "exo": "tsx scripts/show-exercise.ts",
    "check": "npm run build && tsx scripts/check-build.ts",
    "indexnow": "tsx scripts/indexnow.ts"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "firebase": "^12.18.0",
    "qrcode-generator": "^2.0.4"
  }
}
