rules_version = '2';

// Regles de la base Firestore du projet `cirkali`.
//
// Ce fichier est la TRACE de ce qui doit etre publie : la CI ne le deploie pas
// (le depot n'a pas de firebase-tools, et le site part par Cloudflare Workers
// Static Assets, qui ne sait rien de Firebase). A copier dans
// Firestore > Regles apres toute modification ici — une regle ecrite ici et
// non collee la-bas ne protege rien.
//
// C'est ce qui protege reellement les donnees : la config web de
// src/cloud/firebase.ts est publique par nature, et n'autorise rien par
// elle-meme.
service cloud.firestore {
  match /databases/{database}/documents {

    // Un document par compte, portant l'etat complet (cf. cloud/sync.ts).
    // Chacun ne lit et n'ecrit que le sien : `request.auth.uid == uid` est la
    // seule regle qui compte ici.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Exercices crees a la main, remontes pour savoir ce qui manque a la
    // bibliotheque (cf. cloud/exercise-feedback.ts). Un document par nom
    // normalise, donc une collection bornee par le nombre de noms distincts.
    //
    // C'est la SEULE collection ecrivable sans compte, parce que la collecte
    // vise aussi les visiteurs anonymes. Ce qui est verrouille ici, c'est la
    // FORME de ce qu'on peut ecrire — pas le volume : personne ne peut lire,
    // supprimer, ni ecrire autre chose que ces cinq champs, mais rien
    // n'empeche quelqu'un d'epuiser le quota d'ecritures du projet. Si ca
    // arrive, la sortie de secours est de passer `create` a `if false` : la
    // collecte s'arrete, la sauvegarde en ligne repart.
    match /customExercises/{slug} {
      // Pas enumerable : seule la console, qui passe outre ces regles, lit
      // cette collection. Et rien ne s'efface, pour qu'un tiers ne puisse pas
      // faire disparaitre le signal.
      allow read, delete: if false;

      allow create:
        if request.resource.data.keys().hasOnly(['name', 'group', 'count', 'firstAt', 'lastAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        // `group` est un champ libre, volontairement : la liste des groupes
        // vivait ici en copie de GROUP_IDS (src/data/groups.ts), que les
        // regles ne peuvent pas importer. Ce couplage se serait paye au
        // premier groupe ajoute — la regle aurait rejete en silence une valeur
        // pourtant legitime, et la collecte etant muette par conception,
        // personne ne l'aurait vu. Seule la longueur est bornee, pour qu'on ne
        // puisse pas y loger autre chose qu'un identifiant.
        //
        // Le client, lui, n'envoie que les 9 valeurs connues (la modale est un
        // <select>) : cette regle est plus large que l'usage reel, elle ne
        // protege que du remplissage hostile.
        && request.resource.data.group is string
        && request.resource.data.group.size() > 0
        && request.resource.data.group.size() <= 40
        && request.resource.data.count == 1;

      // Un seul geste autorise : incrementer le compteur de un. Le nom et le
      // groupe sont donc figes par le premier a les avoir ecrits, et un tiers
      // ne peut pas retourner l'entree en autre chose apres coup.
      allow update:
        if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastAt'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // Tout le reste est refuse. Regle explicite plutot qu'implicite : elle
    // survit a l'ajout d'une future collection dont on aurait oublie de
    // definir les droits.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
